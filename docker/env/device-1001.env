# STT 엔진 접속 정보
STT_HOST=host.stt.com
STT_PORT=9999

# 음성 코덱 정보 (raw_8k:0, raw_16k:1, ulaw:2, alaw:3)
CODEC=0

# 내부연계 MQTT 브로커 (내부망)
# 주의: 컨테이너 안에서 host를 가리킬 때 127.0.0.1은 컨테이너 자기 자신을 의미합니다.
#       호스트에 떠 있는 EMQX를 가리키려면 host.docker.internal 또는 실제 서버 IP를 사용하세요.
SRC_MQTT_URL=ssl://host.docker.internal:8883
SRC_MQTT_ID=id
SRC_MQTT_PWD=pwd

# 외부연계 MQTT 브로커
STT_MQTT_URL=ssl://host.docker.internal:8883
STT_MQTT_ID=id
STT_MQTT_PWD=pwd

# 수보자(내선) 정보
CALLEE_NO=1001
DEVICE_HOST=192.168.3.192

# 기관 정보
ORG_ID=019ced2f-34ad-7ff8-8681-cd8b77e32313

# timezone
TZ=Asia/Seoul
